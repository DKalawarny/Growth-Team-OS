# ============================================================================
# GrowthOS — example browser environment file
#
# Copy this file to `.env.local` (gitignored) and fill in the values you need.
# Anything prefixed VITE_ is shipped to the browser bundle at build time, so
# treat everything in this file as PUBLIC. Secret keys (Anthropic, Stripe,
# Resend, etc.) belong in Supabase Edge Function secrets, NOT here — see the
# "Edge Function secrets" section of the README.
# ============================================================================

# ─── Required ────────────────────────────────────────────────────────────────

# Supabase project URL. Settings → API → Project URL.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key. Settings → API → Project API keys → `anon`.
# This is safe to ship to the browser; row-level security is what protects
# the data, not key secrecy.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Optional — enables specific features when set ───────────────────────────

# OpenAI key used by the RAG indexer to compute embeddings for uploaded
# knowledge files and document images. Without this, knowledge-file ingestion
# still works but semantic search across them is disabled.
# Get one at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Google Drive Picker — both must be set together to enable the "Import from
# Google Drive" button inside the Library modal. Skip both to hide the button.
#   Client ID:  Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
#   API key:    Google Cloud Console → APIs & Services → Credentials → API key (Drive + Picker APIs enabled)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# OneDrive Picker — set to enable the "Import from OneDrive" button in the
# Library modal. Skip to hide the button.
#   Azure → App registrations → your app → Application (client) ID
VITE_ONEDRIVE_CLIENT_ID=

# Amazon affiliate tag, used by the affiliate-link helper to monetize the
# product recommendations Solomon makes. Skip to render plain Amazon links
# without an affiliate tag.
VITE_AMAZON_AFFILIATE_TAG=

# ─── Removed (do not re-add) ─────────────────────────────────────────────────
#
# VITE_ANTHROPIC_API_KEY  — Retired. The Anthropic key now lives ONLY in the
#                           `claude` Edge Function secret. Shipping it to the
#                           browser leaked it in every customer's network tab.
