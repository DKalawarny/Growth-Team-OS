{
  // ⚠️ The DEPLOY config. `wrangler.jsonc` beside it is read by the Vite plugin
  // during the build and must stay assets-only, or the plugin changes the shape
  // of `dist` and breaks the prerender step.
  // 🔴 `dist/_redirects` MUST BE DELETED BEFORE UPLOAD (`npm run deploy` does it).
  // It is Netlify's rule file; Cloudflare reads the same filename, rejects the
  // domain-based rules in it, and refuses the whole upload.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growthos",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  // ⚠️ ROUTES, not custom domains: these sit on top of the DNS rows Cloudflare
  // imported (the orange-cloud A and www rows), so nothing in DNS has to be
  // deleted or re-created for the site to move.
  "routes": [
    { "pattern": "getunstuckmap.com/*", "zone_name": "getunstuckmap.com" },
    { "pattern": "www.getunstuckmap.com/*", "zone_name": "getunstuckmap.com" },
    { "pattern": "eliv8os.com/*", "zone_name": "eliv8os.com" },
    { "pattern": "www.eliv8os.com/*", "zone_name": "eliv8os.com" },
    { "pattern": "leadeos.com/*", "zone_name": "leadeos.com" },
    { "pattern": "www.leadeos.com/*", "zone_name": "leadeos.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
