{
  // ⚠️ The DEPLOY config. `wrangler.jsonc` beside it is read by the Vite plugin
  // during the build and must stay assets-only, or the plugin changes the shape
  // of `dist` and breaks the prerender step.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growthos",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  }
}
